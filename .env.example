# --- LLM (общий ключ организаторов, OpenAI-совместимый API) ---
# auto (по умолчанию) — live при наличии LLM_API_KEY, иначе replay
# live — вызывать разрешённые модели; replay — только сохранённые ответы из data/snapshot (без ключа, 0 ₽)
# mock — без LLM вообще (детерминированный режим)
LLM_MODE=auto
LLM_BASE_URL=https://changellenge.up.railway.app/v1
LLM_API_KEY=
LLM_TIMEOUT_S=60

# --- Данные ---
# Каталог с CSV. По умолчанию: data/raw (свои CSV) → data/case (данные кейса в репозитории) → data/sample
# DATA_SOURCE_DIR=/app/data/raw
# Ограничить число компаний для быстрого старта (0 = все 85 тыс.)
MAX_COMPANIES=0

# --- Новости ---
# Фоновый сбор RSS (config/sources.yaml) каждые schedule_minutes
ENABLE_SCHEDULER=false
# Разрешить анализ новости по ссылке (/api/news/analyze с url)
ALLOW_URL_FETCH=true

# Подгружать снапшот результатов LLM (data/snapshot) при первом запуске
USE_SNAPSHOT=true
