# --- LLM (общий ключ организаторов, OpenAI-совместимый API) ---
# mock — без вызовов LLM (детерминированный режим, 0 ₽); live — разрешённые модели из config/models.yaml
LLM_MODE=mock
LLM_BASE_URL=https://<эндпоинт-организаторов>/v1
LLM_API_KEY=
LLM_TIMEOUT_S=60

# --- Данные ---
# Каталог с CSV кейса. По умолчанию data/raw, если там пусто — data/sample (синтетика)
# DATA_SOURCE_DIR=/app/data/raw
# Ограничить число компаний для быстрого старта (0 = все 85 тыс.)
MAX_COMPANIES=0

# --- Новости ---
# Фоновый сбор RSS (config/sources.yaml) каждые schedule_minutes
ENABLE_SCHEDULER=false
# Разрешить анализ новости по ссылке (/api/news/analyze с url)
ALLOW_URL_FETCH=true
